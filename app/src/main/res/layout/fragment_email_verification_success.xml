<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/iv_check_container"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_circle_purple" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="-74dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/white"
            android:rotation="-90"
            android:scaleX="1.5"
            android:scaleY="1.5"/>

        <!-- Note: Using a simple chevron rotated as a placeholder for a checkmark -->

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:fontFamily="@font/poppinsbold"
            android:text="Email Verified!"
            android:textColor="@color/noctra_purple_dark"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppinsregular"
            android:gravity="center"
            android:text="Your account is now secure. You can now change your password and manage your account safely."
            android:textColor="@color/noctra_purple_dark"
            android:textSize="16sp"
            android:lineSpacingExtra="4sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/noctra_purple"
        android:fontFamily="@font/poppinsbold"
        android:text="Continue to App"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>