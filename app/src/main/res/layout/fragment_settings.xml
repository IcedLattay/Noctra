<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Settings"
            android:textColor="@color/noctra_purple_dark"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/noctra_purple_faint" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ACCOUNT MANAGEMENT -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="ACCOUNT MANAGEMENT" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="8dp">

                <!-- Display Name row -->
                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsFieldLabel"
                            android:text="Display Name" />
                        <TextView
                            android:id="@+id/value_display_name"
                            style="@style/SettingsFieldValue"
                            tools:text="mesha" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Email row -->
                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsFieldLabel"
                            android:text="Email" />
                        <TextView
                            android:id="@+id/value_email"
                            style="@style/SettingsFieldValue"
                            tools:text="me@example.com" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Change Password row -->
                <LinearLayout
                    android:id="@+id/row_change_password"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_key"
                        android:tint="@color/black" />

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Change Password"
                        android:textColor="@color/black" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Delete Account row -->
                <LinearLayout
                    android:id="@+id/row_delete_account"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_delete" />

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Delete Account"
                        android:textColor="@color/noctra_destructive_red" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROUTINE MANAGEMENT -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_marginTop="24dp"
                android:text="ROUTINE MANAGEMENT" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/SettingsRow">
                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_summary_clock"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Target Bedtime"
                            android:textColor="@color/black" />
                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Time you want to be asleep by" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_bedtime_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bedtime_pill_background_settings"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="left"
                    tools:text="10:00 PM" />
            </LinearLayout>

            <!-- SLEEP MONITORING -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_marginTop="24dp"
                android:text="SLEEP MONITORING" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/row_health_connect"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_health_pulse"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Health Connect"
                            android:textColor="@color/black" />
                        <TextView
                            android:id="@+id/tv_health_status_subtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Not connected" />
                    </LinearLayout>

                    <View
                        android:id="@+id/health_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_status_green_dot"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- NOTIFICATIONS -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_marginTop="24dp"
                android:text="NOTIFICATIONS" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/SettingsRow">
                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Wind-Down Reminders"
                            android:textColor="@color/black" />
                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Notify me to start my routine" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_wind_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/noctra_purple_light"
                        app:trackTint="@color/noctra_purple_faint" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">
                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Morning Sleep Score"
                            android:textColor="@color/black" />
                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Get my sleep score notification" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_morning_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/noctra_purple_light"
                        app:trackTint="@color/noctra_purple_faint" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_notification_permissions"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Notification Permissions"
                            android:textColor="@color/black" />
                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Manage system notification settings" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_alarm_permissions"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_summary_clock"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Exact Alarm Permissions"
                            android:textColor="@color/black" />
                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Required for precise wind-down timing" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- ABOUT -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_marginTop="24dp"
                android:text="ABOUT" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/SettingsRow">
                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_info_circle"
                        android:tint="@color/black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="App Version"
                            android:textColor="@color/black" />
                        <TextView
                            android:id="@+id/value_app_version"
                            style="@style/SettingsRowSubtitle"
                            tools:text="1.0.0" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_privacy_policy"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_document"
                        android:tint="@color/black" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Privacy Policy"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_terms_of_use"
                    style="@style/SettingsRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_document"
                        android:tint="@color/black" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Terms of Use"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_sign_out"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sign Out"
                android:textSize="15sp"
                android:textColor="@color/noctra_destructive_red"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:fontFamily="@font/poppinsbold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>