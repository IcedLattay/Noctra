<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctra_lavender_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_health_pulse"
        app:title="@string/health_settings_title"
        app:titleTextColor="@color/noctra_text_dark" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:strokeColor="@color/noctra_lavender_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSleepLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/health_settings_sleep_label"
                android:textColor="@color/noctra_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSleepStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/health_settings_status_not_shared"
                android:textColor="@color/noctra_text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHrLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/health_settings_hr_label"
                android:textColor="@color/noctra_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/health_settings_status_not_shared"
                android:textColor="@color/noctra_text_muted"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvOverallStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/health_settings_status_disconnected"
        android:textColor="@color/noctra_text_muted"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus" />

    <Button
        android:id="@+id/btnManagePermissions"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/health_settings_manage"
        android:textAllCaps="false"
        android:textColor="@color/noctra_purple"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvOverallStatus"
        app:strokeColor="@color/noctra_purple" />

</androidx.constraintlayout.widget.ConstraintLayout>
