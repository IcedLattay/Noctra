<?xml version="1.0" encoding="utf-8"?>
<!-- Session 5 — long-press activity info dialog (matches user's mockup). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp">

                <!-- Round illustration -->
                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="75dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_info_illustration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_illus_placeholder"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/illus_breathing" />
                </androidx.cardview.widget.CardView>

                <!-- Badge + title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_info_step"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_info_step_badge"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tv_info_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:textColor="#1E1452"
                        android:textSize="20sp"
                        tools:text="Slow-Paced Breathing" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_info_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppinsregular"
                    android:textColor="#2A2160"
                    android:textSize="15sp"
                    tools:text="15 minutes" />

                <!-- DESCRIPTION box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_info_box_description"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:letterSpacing="0.05"
                        android:text="DESCRIPTION"
                        android:textColor="#5B3CC4"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_info_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinsregular"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#3D3566"
                        android:textSize="14sp"
                        tools:text="Slow, steady breaths tell your body it's safe to rest." />
                </LinearLayout>

                <!-- ACTIVITY TYPE box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_box_type"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:letterSpacing="0.05"
                        android:text="ACTIVITY TYPE"
                        android:textColor="#D9A514"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_info_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinsregular"
                        android:textColor="#3D3566"
                        android:textSize="14sp"
                        tools:text="Breathing · Follow the guided breathing circle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Round X, top-right -->
            <ImageButton
                android:id="@+id/btn_info_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_info_close_button"
                android:contentDescription="Close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close_info" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>