<?xml version="1.0" encoding="utf-8"?>
<!--
    "Choose Your Activities" grid card.
    White card + purple outline when selected, illustration, two-line name
    (no duration). Check badge straddles top-right; info ⓘ straddles
    bottom-right. Both live on the wrapper (outside the card) so the card
    keeps its exact size; wrapper padding is the overflow zone. Adapter
    wiring (badge visibility, info click) unchanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#D9D4F0"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Illustration -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivActivityIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_illus_placeholder"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/illus_reading" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvActivityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppinsbold"
                android:lines="2"
                android:maxLines="2"
                android:textColor="#16056E"
                android:textSize="12sp"
                tools:text="Slow-Paced Breathing" />
        </LinearLayout>

        <!-- Selected check badge (inside the card, 8dp off top-right corner) -->
        <ImageView
            android:id="@+id/ivCheckSelected"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Selected"
            android:elevation="2dp"
            android:src="@drawable/ic_selected_check"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Info button (grey circle, plain corner sit) -->
    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_info_circle"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_info_circle"
        android:contentDescription="Activity details" />

</FrameLayout>
