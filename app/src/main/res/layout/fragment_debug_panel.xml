<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Header -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/noctra_purple_dark"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_debug_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/poppinsbold"
        android:text="Debug Panel"
        android:textColor="@color/white"
        android:textSize="28sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintBottom_toBottomOf="@id/tv_debug_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_debug_title"
        app:tint="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Onboarding -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="Section 1 — Onboarding" />

            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_onboarding"
                        style="@style/DebugButton"
                        android:text="Reset Onboarding" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Clears SharedPreferences onboarding completion flag so the first-launch flow plays again on next app open." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 2: Routine -->
            <TextView
                style="@style/DebugSectionHeader"
                android:layout_marginTop="24dp"
                android:text="Section 2 — Routine" />

            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_force_window"
                        style="@style/DebugButton"
                        android:text="Force Show Routine Window" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Forces the Start My Routine button to appear on RoutineHomeFragment regardless of actual current time." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fire_notif"
                        style="@style/DebugButton"
                        android:text="Fire Wind-Down Notification" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Immediately delivers the wind-down push notification without waiting for the scheduled time." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 3: Sleep & Morning Sync -->
            <TextView
                style="@style/DebugSectionHeader"
                android:layout_marginTop="24dp"
                android:text="Section 3 — Sleep &amp; Morning Sync" />

            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simulate_morning"
                        style="@style/DebugButton"
                        android:text="Simulate Morning Sync" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Runs sleep quality processing on the most recent mock sleep record, saves the result, and triggers the morning popup." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simulate_missed"
                        style="@style/DebugButton"
                        android:text="Simulate Missed Night" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Records a missed routine session for the previous night, resets the streak to zero, and queues the missed routine in-app warning message." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 4: Gamification -->
            <TextView
                style="@style/DebugSectionHeader"
                android:layout_marginTop="24dp"
                android:text="Section 4 — Gamification" />

            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_trigger_evolution"
                        style="@style/DebugButton"
                        android:text="Trigger Evolution Animation" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Temporarily pushes XP over the next evolution milestone to demonstrate the Shleepy evolution animation." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_evolution"
                        style="@style/DebugButton"
                        android:text="Preview Evolution Screen" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the evolution dialog for the next stage directly. No XP is written — purely a visual preview." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_stages"
                        style="@style/DebugButton"
                        android:text="Preview Stage Animations" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Plays the default-outfit animation for each of the 5 stages. No data is touched." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 5: Data -->
            <TextView
                style="@style/DebugSectionHeader"
                android:layout_marginTop="24dp"
                android:text="Section 5 — Data" />
            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_seed_data"
                        style="@style/DebugButton"
                        android:text="Seed 7 Days of Demo Data" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Inserts 7 days of mock routine_sessions and sleep_records into Supabase with realistic varying scores and a mix of completed and missed nights." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_data"
                        style="@style/DebugButton.Destructive"
                        android:text="Clear All Demo Data" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Deletes all seeded mock data from Supabase for the current anonymous user ID so the demo can be restarted cleanly." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 6: Dialog Previews -->
            <TextView
                style="@style/DebugSectionHeader"
                android:layout_marginTop="24dp"
                android:text="Section 6 — Dialog Previews" />

            <androidx.cardview.widget.CardView style="@style/DebugCard">
                <LinearLayout style="@style/DebugCardContent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_morning"
                        style="@style/DebugButton"
                        android:text="Preview Morning Recap" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the morning report popup with sample data (score 82, +7 XP). Nothing is written." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_streak_restored"
                        style="@style/DebugButton"
                        android:text="Preview Streak Restored" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the streak-restored notice. Nothing is written." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_streak_lost"
                        style="@style/DebugButton"
                        android:text="Preview Streak Lost" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the streak-broken notice. Nothing is written." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_streak_warning"
                        style="@style/DebugButton"
                        android:text="Preview Streak Warning" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the streak-safe notice. Nothing is written." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_resume"
                        style="@style/DebugButton"
                        android:text="Preview Resume Dialog" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens the resume-routine dialog (step 2 of 3, away 25 min). Its buttons dismiss without effect." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dump_sleep"
                        style="@style/DebugButton"
                        android:text="Dump Latest Sleep Session" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Logs the latest sleep session window plus one line per stage. Read-only — use NoctraLogs or logcat." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dump_heartrate"
                        style="@style/DebugButton"
                        android:text="Dump Sleep Heart Rate" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Logs HR samples inside the latest sleep window, plus count and average. Read-only." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_resync_night"
                        style="@style/DebugButton"
                        android:text="Resync Last Night" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Forces a full sync of yesterday's session (idempotent upsert). Use for late-arriving data." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_backfill_now"
                        style="@style/DebugButton"
                        android:text="Run Backfill Now" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Runs the audit backfill worker immediately instead of waiting for 22:00. Same code path." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_sequencing"
                        style="@style/DebugButton"
                        android:text="Preview Arrange Screen" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens step-3 arrange with your active routine, Confirm hidden — look and reorder freely, nothing is saved." />

                    <View style="@style/DebugDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_breathing"
                        style="@style/DebugButton"
                        android:text="Preview Breathing" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_audioscape"
                        style="@style/DebugButton"
                        android:text="Preview Ambient" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_gratitude"
                        style="@style/DebugButton"
                        android:text="Preview Journaling" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_timer"
                        style="@style/DebugButton"
                        android:text="Preview Stretch / PMR" />
                    <TextView
                        style="@style/DebugDescription"
                        android:text="Opens that activity flow standalone with writes disabled — finishing writes nothing, Back returns here." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>