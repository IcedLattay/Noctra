<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F4FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Padded container: header, duration card, instruction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/shleepylogo"
                    android:contentDescription="Shleepy mascot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arrange Your Routine"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#16056E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 3 of 5"
                        android:textSize="13sp"
                        android:textColor="#7B6FA0" />

                </LinearLayout>
            </LinearLayout>

            <!-- Total duration card (same purple as step 1 hint card) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#EAE6FF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Routine Duration"
                        android:textSize="13sp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/tvTotalDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 minutes"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#16056E"
                        android:layout_marginVertical="4dp" />

                    <TextView
                        android:id="@+id/tvRoutineStartHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your routine will start 0 minutes before your target bedtime"
                        android:textSize="13sp"
                        android:textColor="@android:color/black" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instruction text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Long-press and drag a card, or tap the arrows, to reorder."
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            </LinearLayout><!-- /padded container -->

            <!-- Sequencing list (full-bleed so badges can overhang;
                 top/bottom breathing room so dragged cards don't clip) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSequence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginBottom="0dp" />

            <!-- Spacer: pins the button to the bottom on short content,
                 collapses away when scrolling is needed -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="12dp" />

            <!-- Confirm button (scrolls with content) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="8dp"
                android:text="Complete Routine Setup"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#5C25F0"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>