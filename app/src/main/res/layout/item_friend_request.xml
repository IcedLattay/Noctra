<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_leaderboard_friend_outline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Shleepy avatar (frozen Charged sprite + equipped wearables) -->
        <com.noctra.app.ui.social.ShleepyAvatarView
            android:id="@+id/avatar_shleepy"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <!-- Name + Email -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Hannah Wells" />

            <TextView
                android:id="@+id/text_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/noctra_text_muted"
                android:textSize="13sp"
                tools:text="wellsy@gmail.com" />
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Decline / Cancel -->
            <ImageView
                android:id="@+id/btn_decline"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_grey"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Decline" />

            <!-- Accept (received only) -->
            <ImageView
                android:id="@+id/btn_accept"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_purple"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:src="@drawable/ic_check"
                android:tint="@color/white"
                android:contentDescription="Accept" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
