<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_times_up_transition.xml — Session 5 (R4) polish.

    Layout (vertically centered):
      Shleepy mark (top)
      Alarm clock on a soft glow circle
      "Time's Up!" pill
      Completion message (lavender card)
      UP NEXT card: illustration + name + duration
      Countdown ring: "Starting in" + number

    Kept IDs: tv_encouragement, tv_countdown.
    New IDs:  card_next_up, iv_next_illustration, tv_next_name,
              tv_next_duration, progress_countdown.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/routinestatebackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="@drawable/routinewhitebg">

        <!-- Soft radial backdrop, same as the activity screens -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_activity_screen" />

        <!-- Shleepy mark, top center -->
        <ImageView
            android:id="@+id/imgShleepyHead"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/shleepylogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ── Centered content block ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/contentBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgShleepyHead">

            <!-- Alarm clock on a soft glow circle -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_times_up_glow">

                <ImageView
                    android:id="@+id/imgAlarmClock"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="Time's up"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_alarm_clock" />
            </FrameLayout>

            <!-- "Time's Up!" pill -->
            <TextView
                android:id="@+id/tvTimesUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_times_up_pill"
                android:fontFamily="@font/poppinsbold"
                android:paddingHorizontal="28dp"
                android:paddingVertical="8dp"
                android:text="Time's Up!"
                android:textColor="@color/timer_red"
                android:textSize="24sp" />

            <!-- Completion message for the activity that just ended -->
            <TextView
                android:id="@+id/tv_encouragement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_info_box_description"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="#3B3560"
                android:textSize="14sp"
                tools:text="Good job! Your body will start cooling down." />

            <!-- UP NEXT card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_next_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/iv_next_illustration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_illus_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/illus_reading" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsbold"
                            android:letterSpacing="0.08"
                            android:text="UP NEXT"
                            android:textColor="#D9A514"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_next_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsbold"
                            android:maxLines="1"
                            android:textColor="#1E1452"
                            android:textSize="15sp"
                            tools:text="Reading" />

                        <TextView
                            android:id="@+id/tv_next_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:textColor="#7B6FA0"
                            android:textSize="12sp"
                            tools:text="10 minutes" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Countdown ring -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Starting in"
                android:textColor="#7B6FA0"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100"
                    app:indicatorColor="#4B2FB5"
                    app:indicatorInset="0dp"
                    app:indicatorSize="64dp"
                    app:trackColor="#E4DDF3"
                    app:trackThickness="5dp" />

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/poppinsbold"
                    android:textColor="#4B2FB5"
                    android:textSize="22sp"
                    tools:text="5" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
