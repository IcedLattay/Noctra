<?xml version="1.0" encoding="utf-8"?>
<!-- Scroll-to-top button, full-bleed: circle + arrow drawn together at
     exact coordinates so no image-placement behavior can shift the arrow.
     40x40 viewport displayed at 40dp = 1:1, no scaling. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <path
        android:fillColor="#522ABE"
        android:pathData="M20,20m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0" />
    <path
        android:pathData="M20,28L20,12M14,18L20,12L26,18"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:strokeColor="#ffffff"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
