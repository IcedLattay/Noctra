<?xml version="1.0" encoding="utf-8"?>
<!-- Session 5 (R5): Resume Routine pill — gold, matches the Resume dialog's "current step" dot. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#C98F1C" android:endColor="#B07A10" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F0BC47" android:endColor="#E0A72E" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>