    <string name="health_grant_why_title">Why Health Connect?</string>
    <string name="health_grant_why_description">Noctra uses Health Connect to passively monitor your sleep quality each night. This helps us understand if your routine is working and provide personalized insights — all without you having to do anything extra.</string>
