<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavTextActive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/bottom_nav_item_color</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bottom_nav_item_color</item>
    </style>

    <!-- Section label like "ACCOUNT MANAGEMENT" -->
    <style name="SettingsSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/noctra_label_grey</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- White rounded card with faint purple outline -->
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_status_outline</item>
    </style>

    <!-- One row inside a card -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SettingsRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/noctra_purple_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/noctra_label_grey</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- Label for display name / email (muted grey, regular, smaller) -->
    <style name="SettingsFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/noctra_label_grey</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Value for display name / email (black, larger) -->
    <style name="SettingsFieldValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/noctra_purple_faint</item>
    </style>


    <style name="BedtimePickerTheme" parent="">
        <item name="android:colorControlNormal">@color/noctra_purple_dark</item>
        <item name="android:textColorPrimary">@color/noctra_purple_dark</item>
    </style>

    <!-- ══ ANALYTICS STYLES (ANALYTICS_SPEC.md §6) ══ -->

    <!-- Section heading — follows NEW_ANALYTICS_UI, which renders section titles
         in title case at 18sp ("Sleep Score", "Bedtime Adherence") rather than
         the ALL CAPS 13sp that spec §6's token list describes. Confirmed with
         the user that the wireframe wins, per the spec's own "wireframe is
         visual truth" precedence. The literal §6 variant was carried through
         development as AnalyticsSectionLabel and deleted in Phase 8 once
         nothing referenced it — two near-identical heading styles is exactly
         the confusion the next reader should not inherit. -->
    <style name="AnalyticsSectionHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Range control label — the "Jun 14, 2026 - Jun 20, 2026" subtitle -->
    <style name="AnalyticsRangeLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Chart legend label — spec §6: 12sp black -->
    <style name="AnalyticsLegendLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Perfect-circle FAB overlay: Material3 FABs default to a squircle. -->
    <style name="CircleFab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Stat tile label (above the value) — spec §6 item 3: the four labels are
         analytics_muted, values are black -->
    <style name="StatTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/analytics_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Stat tile value — black per spec §6 item 3 -->
    <style name="StatTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OtpDigitBox">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/noctra_purple_dark</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppinsbold</item>
    </style>

</resources>